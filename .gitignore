# --------------------
# ChefAI .gitignore
# --------------------

# 1. Virtual Environment
venv/

# 2. System Files
.DS_Store
Thumbs.db

# 3. Python Compiled Files
__pycache__/
*.pyc
*.pyo

# 4. Logs and Temporary Files
*.log
tmp/

# 5. Environment Variables
.env

# 6. Node.js Dependencies (Frontend)
node_modules/
