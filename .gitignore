# --------------------
# ChefAI .gitignore
# --------------------

# 1. Virtual Environment (Crucial for performance)
# Ignore the entire venv folder containing installed libraries
venv/

# 2. System Files
.DS_Store
Thumbs.db

# 3. Python Compiled Files and Metadata
__pycache__/
*.pyc
*.pyo

# 4. Logs and Temporary Files
*.log
/tmp/

# 5. Environment Variables
.env
